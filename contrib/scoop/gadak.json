{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.22.0",
    "description": "Local SQLite mirror of your Jira issues — web UI and agent SQL",
    "homepage": "https://github.com/midagedev/gadak",
